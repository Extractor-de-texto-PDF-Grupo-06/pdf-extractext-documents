# =============================================================
# pdf-extractext-documents — Variables de entorno (12-Factor III)
# =============================================================
# Copiar como .env y ajustar. El archivo .env NO se versiona.
# En el sistema completo, las define el compose de pdf-extractext-orchestration.
# =============================================================

# ── Aplicación ───────────────────────────────────────────────
APP_NAME=pdf-extractext-documents
LOG_LEVEL=INFO               # DEBUG | INFO | WARNING | ERROR | CRITICAL

# ── Servidor ─────────────────────────────────────────────────
HOST=0.0.0.0
PORT=8000

# ── MongoDB ──────────────────────────────────────────────────
# Con usuario y contraseña: mongodb://usuario:clave@mongodb:27017/?authSource=admin
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB_NAME=pdf_extractext

# Base de los tests de integración. DEBE ser distinta de MONGODB_DB_NAME:
# la suite borra la colección al empezar y al terminar.
MONGODB_TEST_DB_NAME=pdf_extractext_test
